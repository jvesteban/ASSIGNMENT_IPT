@{
    ViewData["Title"] = "Countdown";
    var lines = ViewBag.Lines as List<string>;
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="RepititionStatement" asp-action="RepititionStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Countdown</h3>
            <p class="text-muted small mb-0">Enter a starting number and the program will count down to 0.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="start" class="form-label">Starting Number (0 - 50)</label>
                    <input type="number" step="1" min="0" max="50" id="start" name="start" class="form-control"
                           placeholder="e.g. 10" value="@ViewBag.Start" autofocus />
                    <div class="form-text mt-2">
                        Try 0. A do-while loop still runs once even if the number is already 0.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Start Countdown</button>
                    <a asp-action="Countdown" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (lines != null)
            {
                <div class="output-card">
                    <div class="output-label">@ViewBag.Title2</div>
                    <pre class="loop-output">@string.Join("\n", lines)</pre>
                </div>
            }
        </div>
    </div>
</div>
