@{
    ViewData["Title"] = "Vowel Counter";
    var lines = ViewBag.Lines as List<string>;
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="RepititionStatement" asp-action="RepititionStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Vowel Counter</h3>
            <p class="text-muted small mb-0">Type a word or a sentence and the program will count its vowels and consonants.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="text" class="form-label">Word or Sentence</label>
                    <input type="text" maxlength="200" id="text" name="text" class="form-control"
                           placeholder="e.g. Hello World" value="@ViewBag.Text" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Count Letters</button>
                    <a asp-action="VowelCounter" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (lines != null)
            {
                <div class="output-card">
                    <div class="output-label">@ViewBag.Title2</div>
                    <pre class="loop-output">@string.Join("\n", lines)</pre>
                </div>
            }
        </div>
    </div>
</div>
