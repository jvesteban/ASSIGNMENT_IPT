@{
    ViewData["Title"] = "Repitition Statement";
}

<div class="header-banner">
    <h1 class="h3 fw-bold mb-2">Repitition Statement</h1>
    <p class="mb-0">
        These five examples demonstrate looping in C#: 1 <code>for</code> loop, 2 <code>while</code> loops, and 2 <code>do-while</code> loops. Click any example to try it out.
    </p>
</div>

<div class="row g-4">
    <!-- For Loop (1) -->
    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Multiplication Table</h5>
            <p class="text-muted small mb-4">
                Enter a number and generate its multiplication table from 1 to 10. Uses a <code>for</code> loop.
            </p>
            <a asp-controller="MultiplicationTable" asp-action="MultiplicationTable" class="btn btn-accent mt-auto align-self-start">
                Open Multiplication Table
            </a>
        </div>
    </div>

    <!-- While Loop (1 of 2) -->
    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Sum of Numbers</h5>
            <p class="text-muted small mb-4">
                Add all whole numbers starting from 1 up to your chosen limit. Uses a <code>while</code> loop.
            </p>
            <a asp-controller="SumOfNumbers" asp-action="SumOfNumbers" class="btn btn-accent mt-auto align-self-start">
                Open Sum of Numbers
            </a>
        </div>
    </div>

    <!-- While Loop (2 of 2) -->
    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Even Numbers</h5>
            <p class="text-muted small mb-4">
                Display all positive even numbers up to a specified limit. Uses a <code>while</code> loop.
            </p>
            <a asp-controller="EvenNumbers" asp-action="EvenNumbers" class="btn btn-accent mt-auto align-self-start">
                Open Even Numbers
            </a>
        </div>
    </div>

    <!-- Do-While Loop (1 of 2) -->
    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Countdown</h5>
            <p class="text-muted small mb-4">
                Count down from a starting number down to 0. Uses a <code>do-while</code> loop.
            </p>
            <a asp-controller="Countdown" asp-action="Countdown" class="btn btn-accent mt-auto align-self-start">
                Open Countdown
            </a>
        </div>
    </div>

    <!-- Do-While Loop (2 of 2) -->
    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Fibonacci Sequence</h5>
            <p class="text-muted small mb-4">
                Generate the Fibonacci sequence up to a given number of terms. Uses a <code>do-while</code> loop.
            </p>
            <a asp-controller="Fibonacci" asp-action="Fibonacci" class="btn btn-accent mt-auto align-self-start">
                Open Fibonacci Sequence
            </a>
        </div>
    </div>
</div>
