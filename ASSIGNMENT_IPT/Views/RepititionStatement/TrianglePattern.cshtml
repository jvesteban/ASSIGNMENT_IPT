@{
    ViewData["Title"] = "Triangle Pattern";
    var lines = ViewBag.Lines as List<string>;
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="RepititionStatement" asp-action="RepititionStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Triangle Pattern</h3>
            <p class="text-muted small mb-0">Enter the number of rows and the program will print a triangle of stars.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="rows" class="form-label">Number of Rows (1 - 15)</label>
                    <input type="number" step="1" min="1" max="15" id="rows" name="rows" class="form-control"
                           placeholder="e.g. 5" value="@ViewBag.Rows" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Print Triangle</button>
                    <a asp-action="TrianglePattern" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (lines != null)
            {
                <div class="output-card">
                    <div class="output-label">@ViewBag.Title2</div>
                    <pre class="loop-output">@string.Join("\n", lines)</pre>
                </div>
            }
        </div>
    </div>
</div>
