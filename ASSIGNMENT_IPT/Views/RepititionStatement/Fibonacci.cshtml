@{
    ViewData["Title"] = "Fibonacci Sequence";
    var lines = ViewBag.Lines as List<string>;
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="RepititionStatement" asp-action="RepititionStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Fibonacci Sequence</h3>
            <p class="text-muted small mb-0">Generate the Fibonacci sequence up to a given number of terms using a <code>do-while</code> loop.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="count" class="form-label">Number of Terms (1 - 25)</label>
                    <input type="number" step="1" min="1" max="25" id="count" name="count" class="form-control"
                           placeholder="e.g. 8" value="@ViewBag.Count" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Generate Sequence</button>
                    <a asp-action="Fibonacci" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (lines != null)
            {
                <div class="output-card">
                    <div class="output-label">@ViewBag.Title2</div>
                    <pre class="loop-output">@string.Join("\n", lines)</pre>
                </div>
            }
        </div>
    </div>
</div>
