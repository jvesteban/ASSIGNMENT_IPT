@{
    ViewData["Title"] = "Sum of Numbers";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="RepititionStatement" asp-action="RepititionStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Sum of Numbers</h3>
            <p class="text-muted small mb-0">Enter a number and the program will add 1 + 2 + 3 and so on up to that number.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="limit" class="form-label">Last Number (1 - 10000)</label>
                    <input type="number" step="1" min="1" max="10000" id="limit" name="limit" class="form-control"
                           placeholder="e.g. 100" value="@ViewBag.Limit" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Compute Sum</button>
                    <a asp-action="SumOfNumbers" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Result</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
