@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool isBasicIO = currentController is "BasicInputOutput" or "DisplayName" or "AddNumbers" or "AgeCalculator" or "GradeEval" or "TemperatureConverter";
    bool isConditional = currentController is "ConditionalStatement" or "OddEven" or "SignChecker" or "VotingEligibility" or "LargestNumber" or "DayName";
    bool isRepitition = currentController is "RepititionStatement" or "MultiplicationTable" or "SumOfNumbers" or "Countdown" or "VowelCounter" or "TrianglePattern";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASSIGNMENT_IPT</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASSIGNMENT_IPT.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark top-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    ASSIGNMENT_IPT
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-end">
                    <ul class="navbar-nav gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(isBasicIO ? "active" : "")"
                               asp-area="" asp-controller="BasicInputOutput" asp-action="BasicInputOutput">
                                Basic Input Output
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isConditional ? "active" : "")"
                               asp-area="" asp-controller="ConditionalStatement" asp-action="ConditionalStatement">
                                Conditional Statement
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isRepitition ? "active" : "")"
                               asp-area="" asp-controller="RepititionStatement" asp-action="RepititionStatement">
                                Repitition Statement
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top">
        <div class="container d-flex flex-wrap justify-content-between align-items-center text-muted small">
            <span>&copy; 2026 &mdash; <strong>ASSIGNMENT_IPT</strong></span>
            <span>Integrative Programming &amp; Technologies &bull; ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
