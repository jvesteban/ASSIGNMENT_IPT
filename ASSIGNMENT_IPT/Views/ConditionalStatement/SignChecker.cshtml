@{
    ViewData["Title"] = "Sign Checker";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="ConditionalStatement" asp-action="ConditionalStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Sign Checker</h3>
            <p class="text-muted small mb-0">Enter a number to check if it is positive, negative, or zero.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="number" class="form-label">Number</label>
                    <input type="number" step="any" id="number" name="number" class="form-control"
                           placeholder="e.g. -5" value="@ViewBag.Number" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Check Sign</button>
                    <a asp-action="SignChecker" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Result</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
