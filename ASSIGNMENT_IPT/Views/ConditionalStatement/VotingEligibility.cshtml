@{
    ViewData["Title"] = "Voting Eligibility";
    bool notEligible = ViewBag.Eligible == false;
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="ConditionalStatement" asp-action="ConditionalStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Voting Eligibility</h3>
            <p class="text-muted small mb-0">Enter your age to see if you can vote. The minimum age is 18.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="age" class="form-label">Age</label>
                    <input type="number" step="1" min="0" max="120" id="age" name="age" class="form-control"
                           placeholder="e.g. 18" value="@ViewBag.Age" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Check Eligibility</button>
                    <a asp-action="VotingEligibility" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card @(notEligible ? "output-card-danger" : "")">
                    <div class="output-label">Result</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
