@{
    ViewData["Title"] = "Day Name";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="ConditionalStatement" asp-action="ConditionalStatement" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Day Name</h3>
            <p class="text-muted small mb-0">Enter a number from 1 to 7 to get the day of the week.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="dayNumber" class="form-label">Day Number (1 - 7)</label>
                    <input type="number" step="1" min="1" max="7" id="dayNumber" name="dayNumber" class="form-control"
                           placeholder="e.g. 3" value="@ViewBag.DayNumber" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Get Day</button>
                    <a asp-action="DayName" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Result</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }

            <div class="mt-4 pt-3 border-top">
                <p class="small fw-bold text-muted mb-2">Day Reference:</p>
                <table class="table table-sm table-bordered small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Number</th>
                            <th>Day</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>1</td><td>Monday</td></tr>
                        <tr><td>2</td><td>Tuesday</td></tr>
                        <tr><td>3</td><td>Wednesday</td></tr>
                        <tr><td>4</td><td>Thursday</td></tr>
                        <tr><td>5</td><td>Friday</td></tr>
                        <tr><td>6</td><td>Saturday</td></tr>
                        <tr><td>7</td><td>Sunday</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
