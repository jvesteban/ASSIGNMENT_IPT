@{
    ViewData["Title"] = "Display Name";
}

@section navitems {
    <partial name="_BasicIONav" />
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="app-card">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="card-number">01</span>
                <h3 class="h4 fw-bold mb-0">Display Name</h3>
            </div>
            <p class="text-muted small mb-4">Enter your first name and last name below, then click Display Name.</p>

            <form method="post">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" id="firstName" name="firstName" class="form-control"
                               placeholder="Enter first name" value="@ViewBag.FirstName" autofocus />
                    </div>
                    <div class="col-sm-6">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" id="lastName" name="lastName" class="form-control"
                               placeholder="Enter last name" value="@ViewBag.LastName" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Display Name</button>
                    <a asp-action="DisplayName" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Output</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
