@{
    ViewData["Title"] = "Display Name";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="BasicInputOutput" asp-action="BasicInputOutput" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Display Name</h3>
            <p class="text-muted small mb-0">Type your first name and last name below.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" id="firstName" name="firstName" class="form-control"
                               placeholder="e.g. Juan" value="@ViewBag.FirstName" autofocus />
                    </div>
                    <div class="col-sm-6">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" id="lastName" name="lastName" class="form-control"
                               placeholder="e.g. Dela Cruz" value="@ViewBag.LastName" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Display Name</button>
                    <a asp-action="DisplayName" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Output</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
