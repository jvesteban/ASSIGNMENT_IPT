@{
    ViewData["Title"] = "Basic Input Output";
}

@section navitems {
    <partial name="_BasicIONav" />
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">IPT Assignment</a>
        <span>/</span>
        <span>Basic Input Output</span>
    </div>
    <h1 class="h2 fw-bold mb-2">Basic Input Output</h1>
    <p class="text-muted mb-0">
        This module demonstrates how an ASP.NET Core MVC application reads user input from a form,
        validates and processes the data inside the controller, and returns the output to the view.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card topic-card topic-card-interactive h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="step-badge">Activity 01</span>
                    <span class="mini-tag">String Concatenation</span>
                </div>
                <h2 class="h5 fw-bold mb-2">Display Name</h2>
                <p class="text-muted small mb-4">
                    Accepts your first name and last name, combines them into a formatted full name, and displays a personalized greeting message.
                </p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="DisplayName" asp-action="DisplayName">
                    Open Activity &rarr;
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card topic-card topic-card-interactive h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="step-badge">Activity 02</span>
                    <span class="mini-tag">Arithmetic Operation</span>
                </div>
                <h2 class="h5 fw-bold mb-2">Add Numbers</h2>
                <p class="text-muted small mb-4">
                    Takes two numeric inputs (whole numbers or decimals), computes their sum, and displays the complete addition equation.
                </p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="AddNumbers" asp-action="AddNumbers">
                    Open Activity &rarr;
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card topic-card topic-card-interactive h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="step-badge">Activity 03</span>
                    <span class="mini-tag">Date &amp; Time Calculation</span>
                </div>
                <h2 class="h5 fw-bold mb-2">Age Calculator</h2>
                <p class="text-muted small mb-4">
                    Reads your birthdate and compares it against today's date to calculate your current age in years.
                </p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="AgeCalculator" asp-action="AgeCalculator">
                    Open Activity &rarr;
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card topic-card topic-card-interactive h-100">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="step-badge">Activity 04</span>
                    <span class="mini-tag">Grade Evaluation</span>
                </div>
                <h2 class="h5 fw-bold mb-2">Grade Evaluator</h2>
                <p class="text-muted small mb-4">
                    Evaluates a student grade from 0 to 100, determines if the score is passing or failing, and assigns the corresponding remarks.
                </p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="GradeEval" asp-action="GradeEval">
                    Open Activity &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
