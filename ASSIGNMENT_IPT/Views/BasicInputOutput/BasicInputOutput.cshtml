@{
    ViewData["Title"] = "Basic Input Output";
}

@section navitems {
    <partial name="_BasicIONav" />
}

<div class="header-banner">
    <h2 class="h4 fw-bold mb-1">Basic Input Output</h2>
    <p class="text-muted mb-0">
        Choose one of the 4 activities below to test the form input and output.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">01</span>
                <h5 class="fw-bold mb-0">Display Name</h5>
            </div>
            <p class="text-muted small mb-3">
                Type your first name and last name to display a greeting message on the page.
            </p>
            <a asp-controller="DisplayName" asp-action="DisplayName" class="btn btn-accent btn-sm mt-auto align-self-start">
                Open Display Name &rarr;
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">02</span>
                <h5 class="fw-bold mb-0">Add Numbers</h5>
            </div>
            <p class="text-muted small mb-3">
                Enter two numbers (whole numbers or decimals) and compute their sum.
            </p>
            <a asp-controller="AddNumbers" asp-action="AddNumbers" class="btn btn-accent btn-sm mt-auto align-self-start">
                Open Add Numbers &rarr;
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">03</span>
                <h5 class="fw-bold mb-0">Age Calculator</h5>
            </div>
            <p class="text-muted small mb-3">
                Select your birthdate from the calendar picker to calculate your current age.
            </p>
            <a asp-controller="AgeCalculator" asp-action="AgeCalculator" class="btn btn-accent btn-sm mt-auto align-self-start">
                Open Age Calculator &rarr;
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">04</span>
                <h5 class="fw-bold mb-0">Grade Evaluator</h5>
            </div>
            <p class="text-muted small mb-3">
                Enter a student grade from 0 to 100 to view the corresponding remarks.
            </p>
            <a asp-controller="GradeEval" asp-action="GradeEval" class="btn btn-accent btn-sm mt-auto align-self-start">
                Open Grade Evaluator &rarr;
            </a>
        </div>
    </div>
</div>
