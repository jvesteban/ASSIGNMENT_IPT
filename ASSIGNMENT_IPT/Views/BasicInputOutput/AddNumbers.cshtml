@{
    ViewData["Title"] = "Add Numbers";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="BasicInputOutput" asp-action="BasicInputOutput" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Add Numbers</h3>
            <p class="text-muted small mb-0">Enter two numbers below to get their sum.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label for="firstNumber" class="form-label">First Number</label>
                        <input type="number" step="any" id="firstNumber" name="firstNumber" class="form-control"
                               placeholder="0" value="@ViewBag.FirstNumber" autofocus />
                    </div>
                    <div class="col-sm-6">
                        <label for="secondNumber" class="form-label">Second Number</label>
                        <input type="number" step="any" id="secondNumber" name="secondNumber" class="form-control"
                               placeholder="0" value="@ViewBag.SecondNumber" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Add Numbers</button>
                    <a asp-action="AddNumbers" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Result</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
