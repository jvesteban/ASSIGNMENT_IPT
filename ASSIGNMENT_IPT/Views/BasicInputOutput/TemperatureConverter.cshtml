@{
    ViewData["Title"] = "Temperature Converter";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="BasicInputOutput" asp-action="BasicInputOutput" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Temperature Converter</h3>
            <p class="text-muted small mb-0">Enter a temperature in Celsius to convert it into Fahrenheit.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="mb-4">
                    <label for="celsius" class="form-label">Celsius (&deg;C)</label>
                    <input type="number" step="any" id="celsius" name="celsius" class="form-control"
                           placeholder="e.g. 37" value="@ViewBag.Celsius" autofocus />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Convert</button>
                    <a asp-action="TemperatureConverter" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Result != null)
            {
                <div class="output-card">
                    <div class="output-label">Result</div>
                    <div class="output-value">@ViewBag.Result</div>
                </div>
            }
        </div>
    </div>
</div>
