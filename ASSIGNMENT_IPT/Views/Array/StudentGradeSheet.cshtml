@{
    ViewData["Title"] = "Student Grade Sheet";
    string[] students = ViewBag.Students as string[];
    string[] subjects = ViewBag.Subjects as string[];
    int[,] grades = ViewBag.Grades as int[,];
    double[] averages = ViewBag.Averages as double[];
    double classAverage = ViewBag.ClassAverage != null ? (double)ViewBag.ClassAverage : 0;
}

<div class="row">
    <div class="col-lg-7 mx-auto">
        <a asp-controller="Array" asp-action="Array" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Student Grade Sheet (2D Array)</h3>
            <p class="text-muted small mb-0">Manage a 3&times;3 2D array of grades (<code>int[3, 3]</code>) representing Students &times; Subjects, and compute student averages.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="table-responsive mb-3">
                    <table class="table table-bordered text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Math</th>
                                <th>Science</th>
                                <th>English</th>
                                <th class="table-success">Student Average</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (students != null && grades != null)
                            {
                                string[] prefix = { "j", "m", "p" };
                                string[] subNames = { "Math", "Sci", "Eng" };

                                for (int s = 0; s < 3; s++)
                                {
                                    <tr>
                                        <th class="table-light text-start ps-3">@students[s]</th>
                                        @for (int sub = 0; sub < 3; sub++)
                                        {
                                            string fieldName = prefix[s] + subNames[sub];
                                            <td>
                                                <input type="number" min="0" max="100" name="@fieldName" class="form-control text-center p-1"
                                                       value="@grades[s, sub]" style="min-width: 60px;" />
                                            </td>
                                        }
                                        <td class="table-success fw-bold">
                                            @((averages != null) ? averages[s] : 0)
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="4" class="text-end pe-3">Class Overall Average:</td>
                                <td class="table-primary">@classAverage</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Calculate Averages</button>
                    <a asp-action="StudentGradeSheet" class="btn-reset">Reset</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.HasSubmitted == true)
            {
                <div class="output-card mt-3">
                    <div class="output-label">2D Array Computation Summary</div>
                    <div class="small">
                        Grades have been processed using nested loops across the 2D array (<code>int[3, 3]</code>).
                    </div>
                </div>
            }
        </div>
    </div>
</div>
