@{
    ViewData["Title"] = "Array Statistics";
    var items = ViewBag.Items as List<string>;
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <a asp-controller="Array" asp-action="Array" class="btn-back">&larr; Back</a>

        <div class="app-card">
            <h3 class="h4 fw-bold mb-1">Array Statistics (1D Array)</h3>
            <p class="text-muted small mb-0">Enter 5 numbers to store into a 1D array (<code>int[]</code>) and calculate summary statistics.</p>

            <hr class="my-3 text-muted opacity-25" />

            <form method="post">
                <div class="row g-2 mb-3">
                    <div class="col">
                        <label class="form-label small">Num 1</label>
                        <input type="number" name="num1" class="form-control" value="@ViewBag.Num1" placeholder="10" autofocus />
                    </div>
                    <div class="col">
                        <label class="form-label small">Num 2</label>
                        <input type="number" name="num2" class="form-control" value="@ViewBag.Num2" placeholder="25" />
                    </div>
                    <div class="col">
                        <label class="form-label small">Num 3</label>
                        <input type="number" name="num3" class="form-control" value="@ViewBag.Num3" placeholder="4" />
                    </div>
                    <div class="col">
                        <label class="form-label small">Num 4</label>
                        <input type="number" name="num4" class="form-control" value="@ViewBag.Num4" placeholder="89" />
                    </div>
                    <div class="col">
                        <label class="form-label small">Num 5</label>
                        <input type="number" name="num5" class="form-control" value="@ViewBag.Num5" placeholder="32" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Process 1D Array</button>
                    <a asp-action="ArrayStatistics" class="btn-reset">Clear</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.HasResult == true && items != null)
            {
                <div class="output-card mt-3">
                    <div class="output-label">1D Array Elements</div>
                    <pre class="loop-output mb-3">@string.Join("\n", items)</pre>

                    <div class="row g-2 pt-2 border-top">
                        <div class="col-6 col-sm-3">
                            <span class="small text-muted d-block">Sum</span>
                            <strong>@ViewBag.Sum</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="small text-muted d-block">Average</span>
                            <strong>@ViewBag.Average</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="small text-muted d-block">Minimum</span>
                            <strong>@ViewBag.Min</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="small text-muted d-block">Maximum</span>
                            <strong>@ViewBag.Max</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
