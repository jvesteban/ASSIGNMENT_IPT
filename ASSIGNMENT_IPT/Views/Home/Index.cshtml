@{
    ViewData["Title"] = "Home Page";
}

<div class="header-banner">
    <h1 class="h3 fw-bold mb-2">ASSIGNMENT SA IPT</h1>
    <p class="mb-0">
        Welcome to my IPT assignment project. Choose a topic below to try out the programs we made in ASP.NET Core MVC.
    </p>
</div>

<div class="row g-4">
    <!-- Module 1: Basic Input Output -->
    <div class="col-md-6 col-xl-3">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Basic Input Output</h5>
            <p class="text-muted small mb-3">
                Simple programs where you enter your name, numbers, birthdate, grade, or temperature and the page shows the result.
            </p>
            <div class="quick-link-list mb-4">
                <a asp-controller="DisplayName" asp-action="DisplayName" class="quick-link-item">
                    <span>1. Display Name</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="AddNumbers" asp-action="AddNumbers" class="quick-link-item">
                    <span>2. Add Numbers</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="AgeCalculator" asp-action="AgeCalculator" class="quick-link-item">
                    <span>3. Age Calculator</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="GradeEval" asp-action="GradeEval" class="quick-link-item">
                    <span>4. Grade Evaluator</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="TemperatureConverter" asp-action="TemperatureConverter" class="quick-link-item">
                    <span>5. Temperature Converter</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
            </div>
            <a asp-controller="BasicInputOutput" asp-action="BasicInputOutput" class="btn btn-accent w-100 mt-auto">
                Open Basic Input Output
            </a>
        </div>
    </div>

    <!-- Module 2: Conditional Statement -->
    <div class="col-md-6 col-xl-3">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Conditional Statement</h5>
            <p class="text-muted small mb-3">
                Programs that use <code>if</code>, <code>else if</code>, <code>else</code>, and <code>switch</code> statements to make decisions.
            </p>
            <div class="quick-link-list mb-4">
                <a asp-controller="OddEven" asp-action="OddEven" class="quick-link-item">
                    <span>1. Odd or Even</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="SignChecker" asp-action="SignChecker" class="quick-link-item">
                    <span>2. Sign Checker</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="VotingEligibility" asp-action="VotingEligibility" class="quick-link-item">
                    <span>3. Voting Eligibility</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="LargestNumber" asp-action="LargestNumber" class="quick-link-item">
                    <span>4. Largest Number</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="DayName" asp-action="DayName" class="quick-link-item">
                    <span>5. Day Name</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
            </div>
            <a asp-controller="ConditionalStatement" asp-action="ConditionalStatement" class="btn btn-accent w-100 mt-auto">
                Open Conditional Statement
            </a>
        </div>
    </div>

    <!-- Module 3: Repitition Statement -->
    <div class="col-md-6 col-xl-3">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Repitition Statement</h5>
            <p class="text-muted small mb-3">
                Programs that use <code>for</code>, <code>while</code>, and <code>do-while</code> loops to repeat tasks.
            </p>
            <div class="quick-link-list mb-4">
                <a asp-controller="MultiplicationTable" asp-action="MultiplicationTable" class="quick-link-item">
                    <span>1. Multiplication Table</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="SumOfNumbers" asp-action="SumOfNumbers" class="quick-link-item">
                    <span>2. Sum of Numbers</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="EvenNumbers" asp-action="EvenNumbers" class="quick-link-item">
                    <span>3. Even Numbers</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="Countdown" asp-action="Countdown" class="quick-link-item">
                    <span>4. Countdown</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="Fibonacci" asp-action="Fibonacci" class="quick-link-item">
                    <span>5. Fibonacci Sequence</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
            </div>
            <a asp-controller="RepititionStatement" asp-action="RepititionStatement" class="btn btn-accent w-100 mt-auto">
                Open Repitition Statement
            </a>
        </div>
    </div>

    <!-- Module 4: Array Operations -->
    <div class="col-md-6 col-xl-3">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <h5 class="fw-bold mb-2">Array</h5>
            <p class="text-muted small mb-3">
                Programs that demonstrate One-Dimensional (1D) and Two-Dimensional (2D) array operations in C#.
            </p>
            <div class="quick-link-list mb-4">
                <a asp-controller="ArrayStatistics" asp-action="ArrayStatistics" class="quick-link-item">
                    <span>1. Array Stats (1D)</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="ArraySearch" asp-action="ArraySearch" class="quick-link-item">
                    <span>2. Array Search (1D)</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="MatrixDisplay" asp-action="MatrixDisplay" class="quick-link-item">
                    <span>3. Matrix Display (2D)</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="MatrixRowColSum" asp-action="MatrixRowColSum" class="quick-link-item">
                    <span>4. Row &amp; Col Sum (2D)</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
                <a asp-controller="StudentGradeSheet" asp-action="StudentGradeSheet" class="quick-link-item">
                    <span>5. Grade Sheet (2D)</span>
                    <span class="text-muted small">&rarr;</span>
                </a>
            </div>
            <a asp-controller="Array" asp-action="Array" class="btn btn-accent w-100 mt-auto">
                Open Array
            </a>
        </div>
    </div>
</div>
