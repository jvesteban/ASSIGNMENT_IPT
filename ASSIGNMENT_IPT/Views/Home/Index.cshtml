@{
    ViewData["Title"] = "Home Page";
}

<div class="header-banner">
    <h2 class="h4 fw-bold mb-1">Integrative Programming and Technologies</h2>
    <p class="text-muted mb-0">
        Compilation of our laboratory exercises and activities in ASP.NET Core MVC.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="app-card app-card-hover h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">01</span>
                <h5 class="fw-bold mb-0">Basic Input Output</h5>
            </div>
            <p class="text-muted small mb-3">
                Programs that read user input from a form, process the data in the controller, and show the result.
            </p>
            <div class="list-group list-group-flush small mb-3 border-top border-bottom">
                <a asp-controller="DisplayName" asp-action="DisplayName" class="list-group-item list-group-item-action px-1 py-2">
                    1. Display Name
                </a>
                <a asp-controller="AddNumbers" asp-action="AddNumbers" class="list-group-item list-group-item-action px-1 py-2">
                    2. Add Numbers
                </a>
                <a asp-controller="AgeCalculator" asp-action="AgeCalculator" class="list-group-item list-group-item-action px-1 py-2">
                    3. Age Calculator
                </a>
                <a asp-controller="GradeEval" asp-action="GradeEval" class="list-group-item list-group-item-action px-1 py-2">
                    4. Grade Evaluator
                </a>
            </div>
            <a asp-controller="BasicInputOutput" asp-action="BasicInputOutput" class="btn btn-accent btn-sm mt-auto">
                Open Basic Input Output &rarr;
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="app-card h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">02</span>
                <h5 class="fw-bold mb-0">Conditional Statement</h5>
            </div>
            <p class="text-muted small mb-3">
                Decision-making programs using <code>if</code>, <code>else if</code>, <code>else</code>, and <code>switch</code> statements.
            </p>
            <span class="text-muted small mt-auto">No activities added yet</span>
        </div>
    </div>

    <div class="col-md-4">
        <div class="app-card h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-number">03</span>
                <h5 class="fw-bold mb-0">Repitition Statement</h5>
            </div>
            <p class="text-muted small mb-3">
                Looping programs using <code>for</code>, <code>while</code>, and <code>do-while</code> statements.
            </p>
            <span class="text-muted small mt-auto">No activities added yet</span>
        </div>
    </div>
</div>
